<!DOCTYPE NETSCAPE-Bookmark-file-1>
<!-- {{ ansible_managed }}. Import it in your browser: Bookmarks, Import, HTML file. -->
<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
<TITLE>Bookmarks</TITLE>
<H1>Bookmarks</H1>
<DL><p>
    <DT><H3>Homelab</H3>
    <DL><p>
{% for app in homelab_web_apps | reject('in', homelab_apps_off) %}
        <DT><A HREF="{{ homelab_web_address }}{{ '' if homelab_web_ports[app] == 443 else ':' ~ homelab_web_ports[app] }}">{{ app_config_app_names[app] | default(app | capitalize) }}</A>
{% endfor %}
    </DL><p>
</DL><p>
