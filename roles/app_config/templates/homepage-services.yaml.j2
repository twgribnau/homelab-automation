---
# {{ ansible_managed }}
# Links go to the server's LAN address; widgets and status dots reach the apps on the Docker
# network.
{% macro href(app) %}http://{{ homelab_lan_ip }}:{{ homelab_ports[app] }}{% endmacro %}
- Media:
    - Jellyfin:
        icon: jellyfin.png
        href: {{ href('jellyfin') }}
        siteMonitor: http://jellyfin:8096
        widget:
          type: jellyfin
          version: 2
          url: http://jellyfin:8096
          key: {{ _app_config_jellyfin_api_key }}
          enableBlocks: true
          enableNowPlaying: true
    - Seerr:
        icon: seerr.png
        href: {{ href('seerr') }}
        siteMonitor: http://seerr:5055
        widget:
          type: seerr
          url: http://seerr:5055
          key: {{ _app_config_seerr_key }}
{% if homelab_suggestarr | bool %}
    - SuggestArr:
        icon: suggest-arr.png
        href: {{ href('suggestarr') }}
        siteMonitor: http://suggestarr:5000
{% endif %}
{% if homelab_books | bool %}
    - Calibre-Web:
        icon: calibre-web.png
        href: {{ href('calibre') }}
        siteMonitor: http://calibre:8083
        widget:
          type: calibreweb
          url: http://calibre:8083
          username: {{ homelab_username | to_json }}
          password: {{ homelab_password | to_json }}
{% endif %}

- Downloads:
    - Radarr:
        icon: radarr.png
        href: {{ href('radarr') }}
        siteMonitor: http://radarr:7878
        widget:
          type: radarr
          url: http://radarr:7878
          key: {{ _app_config_api_keys.radarr }}
          enableQueue: true
    - Sonarr:
        icon: sonarr.png
        href: {{ href('sonarr') }}
        siteMonitor: http://sonarr:8989
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: {{ _app_config_api_keys.sonarr }}
          enableQueue: true
{% if homelab_bazarr | bool %}
    - Bazarr:
        icon: bazarr.png
        href: {{ href('bazarr') }}
        siteMonitor: http://bazarr:6767
        widget:
          type: bazarr
          url: http://bazarr:6767
          key: {{ _app_config_bazarr_key }}
{% endif %}
    - Prowlarr:
        icon: prowlarr.png
        href: {{ href('prowlarr') }}
        siteMonitor: http://prowlarr:9696
        widget:
          type: prowlarr
          url: http://prowlarr:9696
          key: {{ _app_config_api_keys.prowlarr }}
    - qBittorrent:
        icon: qbittorrent.png
        href: {{ href('qbittorrent') }}
        siteMonitor: http://gluetun:{{ homelab_ports.qbittorrent }}
        widget:
          type: qbittorrent
          url: http://gluetun:{{ homelab_ports.qbittorrent }}
          username: {{ homelab_username | to_json }}
          password: {{ homelab_password | to_json }}
    - Cleanuparr:
        icon: cleanuparr.png
        href: {{ href('cleanuparr') }}
        siteMonitor: http://cleanuparr:11011/health
    - Maintainerr:
        icon: maintainerr.png
        href: {{ href('maintainerr') }}
        siteMonitor: http://maintainerr:6246
        widget:
          type: maintainerr
          url: http://maintainerr:6246
          fields: [reclaimable, itemsHandled]

{% if homelab_monitoring | bool or (app_config_github_repo and app_config_github_token) %}
- System:
{% endif %}
{% if homelab_monitoring | bool %}
    - Grafana:
        icon: grafana.png
        href: {{ href('grafana') }}
        siteMonitor: http://grafana:3000
        widget:
          type: grafana
          version: 2
          url: http://grafana:3000
          username: {{ homelab_username | to_json }}
          password: {{ homelab_password | to_json }}
    - Prometheus:
        icon: prometheus.png
        siteMonitor: http://prometheus:9090
        widget:
          type: prometheus
          url: http://prometheus:9090
{% if homelab_backup_remote %}
    # Sizes measured after each nightly backup (roles/backup); free space from node-exporter.
    - Storage:
        icon: mdi-harddisk
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 300000
          metrics:
            - { label: Movies, query: 'homelab_media_bytes{dir="movies"}', format: { type: bytes } }
            - { label: Series, query: 'homelab_media_bytes{dir="series"}', format: { type: bytes } }
            - { label: Books, query: 'homelab_media_bytes{dir="books"}', format: { type: bytes } }
            - { label: Free, query: 'node_filesystem_avail_bytes{mountpoint="/"}', format: { type: bytes } }
    # The nightly backup and the weekly check of it (roles/backup).
    - Backup:
        icon: mdi-backup-restore
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 300000
          metrics:
            - { label: Last backup, query: time() - homelab_backup_success_time, format: { type: duration } }
            - { label: Last check, query: time() - homelab_backup_verify_success_time, format: { type: duration } }
            - { label: Size, query: homelab_backup_bytes, format: { type: bytes } }
{% endif %}
{% endif %}
{% if app_config_github_repo and app_config_github_token %}
    # The latest release, from GitHub's API with a read-only token (app_config_github_token).
    # GitHub rejects requests without a User-Agent, and Homepage sends none by itself.
    - GitHub:
        icon: github.png
        href: https://github.com/{{ app_config_github_repo }}/releases
        widget:
          type: customapi
          url: https://api.github.com/repos/{{ app_config_github_repo }}/releases/latest
          headers:
            Authorization: Bearer {{ app_config_github_token }}
            Accept: application/vnd.github+json
            User-Agent: homelab-homepage
          refreshInterval: 300000
          mappings:
            - { field: tag_name, label: Release }
            - { field: published_at, label: Released, format: relativeDate, style: short }
{% endif %}
