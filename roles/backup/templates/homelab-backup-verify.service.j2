# {{ ansible_managed }}
[Unit]
Description=Check that the homelab backups can be restored
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/homelab-backup/env
CacheDirectory=homelab-backup
Environment=RESTIC_CACHE_DIR=/var/cache/homelab-backup
ExecStart=/usr/local/bin/homelab-backup-verify
